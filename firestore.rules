rules_version = '2';

// Regras de segurança do Firestore do app Treino (Fase 1).
// Cada pessoa só lê e escreve o que está dentro do próprio "usuarios/{o id dela}".
// Todo o resto é negado. Na Fase 2 vamos acrescentar o acesso do personal aos alunos ligados a ele.
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{documento=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
